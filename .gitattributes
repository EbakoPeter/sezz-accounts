# Enforce LF line endings for all text files, regardless of the platform
# checking them out or committing them. Without this, Git falls back to
# each contributor's local core.autocrlf setting, which is exactly what
# produces "LF will be replaced by CRLF" warnings on Windows — harmless,
# but inconsistent from one machine to the next. Matches Prettier's default
# (endOfLine: "lf"), so formatting and line endings agree with each other.
* text=auto eol=lf

# Binary files: never touch these, on any platform.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.woff binary
*.woff2 binary
